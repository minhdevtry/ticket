#!/usr/bin/env bash
# Chặn commit khi lint hoặc vệ sinh repo công khai đỏ.
#
# Cài: bun run setup:hooks   (đặt core.hooksPath = .githooks)
# Bỏ: git config --unset core.hooksPath
#
# Chỉ chạy phần nhanh: lint (dưới 1 giây) và scan các file đang staged. Kiểm tra đầy đủ
# (typecheck, test, docs) thuộc `bun run verify` và của CI.
#
# Khi xanh thì im lặng: output của biome dài hơn phần việc và lại in ra mỗi lần commit.
set -uo pipefail

lint_out="$(bun run lint 2>&1)"
lint_code=$?
if [ $lint_code -ne 0 ]; then
  echo "pre-commit: lint đỏ, chưa commit." >&2
  printf '%s\n' "$lint_out" | tail -30 >&2
  echo "Sửa code, hoặc chạy 'bun run format'." >&2
  exit 1
fi

scan_out="$(bun run scan --staged 2>&1)"
scan_code=$?
if [ $scan_code -ne 0 ]; then
  echo "pre-commit: scan đỏ, chưa commit." >&2
  printf '%s\n' "$scan_out" | tail -20 >&2
  echo "Repo là công khai: thay giá trị thật bằng mẫu tổng hợp." >&2
  exit 1
fi

exit 0
