# ==========================================
# CẤU HÌNH INTAKE AGENTS CHO OPENCLAW
# ==========================================

# 1. Tracker (Itsaplan)
ITSAPLAN_BASE_URL="http://localhost:3100"
ITSAPLAN_API_KEY="itsaplan_xxx"
ITSAPLAN_WEB_URL="https://itsaplan.example.com"

# 2. Telegram Bot Tokens (dành cho kênh chat)
TELEGRAM_BOT_TOKEN_TIEULINH="123456789:replace-me"

# Token dùng cho Background Worker (mặc định dùng của Tiểu Linh để thông báo sự cố)
TELEGRAM_BOT_TOKEN="123456789:replace-me"
ON_CALL_CHAT_ID="-1000000000001"

# 3. Onyx RAG (Tuỳ chọn: tìm kiếm tri thức & tự động nạp ticket khi đóng)
ONYX_BASE_URL="https://onyx.example.com"
ONYX_API_KEY="on_xxx"
ONYX_PERSONA_ID="6"
ONYX_DOC_PREFIX="ticket_"

# LLM cho extractor intake_step, tóm tắt ticket, nạp KG/Onyx.
# Được liệt kê nhiều model, phẩy ngăn cách: model trước lỗi 5xx/mạng thì thử model sau.
OPENAI_BASE_URL="http://localhost:8000/v1"
OPENAI_API_KEY="sk-replace-me"
OPENAI_MODEL="mm3/MiniMax-M3,gemini/gemini-3.5-flash-lite"

# 4. Quản lý danh tính & Quyền hạn
ADMIN_IDS="1000000001"
REQUIRE_APPROVAL="true"

# 5. Worker nền (Webhook & Lifecycle)
WEBHOOK_PORT="3102"
LIFECYCLE_INTERVAL_MS="60000"
AGENT_HANDLES="tieulinh_bot,iris_bot"
# Tiểu Linh (TECH): chỉ đẩy comment về người báo khi comment có tag bot.
# Bỏ trống = "all" (mọi comment của người đều tới người báo — dùng cho Iris/PO).
COMMENT_FORWARD_POLICY="mention"

# Mỗi worker khoá theo đúng một dự án (webhook Itsaplan không lọc dự án, hai
# worker dùng chung DB). Thiếu thì worker không khoá và không đăng ký webhook.
ITSAPLAN_PROJECT_KEY="TECH"

# Bảo vệ endpoint webhook (chưa đặt thì vẫn nhận như cũ, chỉ log cảnh báo):
# - ITSAPLAN_WEBHOOK_SECRET: trường "secret" (whsec_...) của subscription, xem
#   GET /projects/<key>/webhooks. Có thể nhiều giá trị, phẩy ngăn cách.
# - TELEGRAM_WEBHOOK_SECRET: đúng secret_token đã truyền khi gọi setWebhook.
ITSAPLAN_WEBHOOK_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
WEBHOOK_MAX_BODY_BYTES="1048576"

# Onyx chỉ nạp cho dự án được liệt kê (mặc định TECH). PO bị chặn cứng — ADR-0002.
ONYX_SYNC_PROJECTS="TECH"

# 6. Knowledge Graph (Memgraph) — CHỈ cho dự án test của Tiểu Linh, KHÔNG dùng cho Iris/PO.
# KG chỉ bật khi có MEMGRAPH_URI VÀ ITSAPLAN_PROJECT_KEY nằm trong KG_SYNC_PROJECTS
# (phẩy ngăn cách; để trống = tắt).
MEMGRAPH_URI="bolt://localhost:7687"
KG_SYNC_PROJECTS=""
KG_SYNC_MAX_ATTEMPTS="6"
KG_SYNC_RETRY_INTERVAL_MS="60000"

# 7. KG MCP HTTP (mcp/kg-http — điểm vào cho Onyx MCP Actions)
# Thiếu KG_MCP_API_KEY thì server KHÔNG khởi động (trừ khi KG_MCP_ALLOW_NO_AUTH=1, chỉ dev).
# Mặc định chỉ nghe 127.0.0.1 — Onyx đi vào qua tunnel; muốn mở LAN phải đặt KG_MCP_HOST="0.0.0.0".
KG_MCP_API_KEY=""
KG_MCP_PORT="8933"
KG_MCP_HOST="127.0.0.1"

# 8. Plugin OpenClaw xac-nhan-xong (đặt trong env của gateway, không phải worker)
# Bảng agent → worker nhận cú bấm "👍 Đã ổn" (reporter_ok). Mặc định: iris-agent=http://127.0.0.1:3103
# XAC_NHAN_XONG_WORKERS="iris-agent=http://127.0.0.1:3103,ticket-intake-agent=http://127.0.0.1:3102"

# 9. Test: `bun test` KHÔNG dùng secret trong .env (test-preload.ts xoá trước khi chạy).
# Test gọi LLM thật chỉ chạy khi: RUN_LIVE_LLM=1 bun test worker/kg-sync.test.ts
